Windows Registry Editor Version 5.00

; Restore the http/https protocol definitions (requires administrator)
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\http]
@="URL:HyperText Transfer Protocol"
"URL Protocol"=""
"EditFlags"=dword:00000002

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\https]
@="URL:HyperText Transfer Protocol with Privacy"
"URL Protocol"=""
"EditFlags"=dword:00000002

; Per-user keys override the system ones, so mark them as URL protocols too
[HKEY_CURRENT_USER\Software\Classes\http]
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\https]
"URL Protocol"=""
